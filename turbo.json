{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "DESIGN.md",
    "scripts/design-model.mjs",
    "scripts/design-tokens.mjs",
    "scripts/check-bundle.mjs"
  ],
  "tasks": {
    "check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/openspec/_research/railway-schema-excerpt.graphql"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "^check"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:live": {
      "cache": false
    }
  }
}
