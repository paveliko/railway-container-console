{
  "name": "railway-container-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run check && node scripts/check-boundaries.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:live": "turbo run test:live"
  },
  "devDependencies": {
    "turbo": "2.10.13",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
