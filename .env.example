# Copy to .env.local and fill in. .env* is git-ignored; .env.example is not.
# Nothing here ever holds a value in the repository.

# Which kind of token RAILWAY_TOKEN is. Decides the auth header, and is
# declared rather than guessed — see decisions.md D-API-2.
#   project   → header  Project-Access-Token: <token>     (recommended: least privilege)
#   account   → header  Authorization: Bearer <token>
#   workspace → header  Authorization: Bearer <token>
RAILWAY_TOKEN_KIND=project

# The token itself. Never commit a value.
RAILWAY_TOKEN=

# The one container this console manages. No picker — see decisions.md D-API-6.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# When set, POST /api/container/up and /down require a session cookie obtained
# from POST /api/session; reads and the SSE stream stay open. Unset = no gate.
#
# The deployed demo sets it — see decisions.md D-SEC-2. Local development
# normally leaves it empty. The value is chosen in the Railway dashboard and
# delivered privately with the demo link; this repository is public, so it is
# never written here or anywhere else in the tree.
CONSOLE_PASSPHRASE=
